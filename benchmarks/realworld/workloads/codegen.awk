# Code-generation fixture for the TraceJIT real-world census.
#
# Reads a TSV schema of the form
#     id<TAB>kind<TAB>name
# and emits a C header declaring a struct field per row. This is the shape of
# real table-driven code generation, not a busy loop: one input file in, one
# generated source file out.
BEGIN {
    print "/* generated by codegen.awk; do not edit */"
    print "#ifndef CENSUS_GENERATED_H"
    print "#define CENSUS_GENERATED_H"
    print ""
    print "#include <stdint.h>"
    print ""
    print "struct census_row {"
    count = 0
}
NR > 1 && NF >= 3 {
    type = ($2 == "u64") ? "uint64_t" : "uint32_t"
    printf "    %s %s; /* id %s */\n", type, $3, $1
    count += 1
}
END {
    print "};"
    print ""
    printf "#define CENSUS_ROW_FIELDS %d\n", count
    print ""
    print "#endif"
}
